COMPOSE_PROJECT_NAME=intelvia
DJANGO_SETTINGS_MODULE=api.settings
INTELVIA_IMAGE_TAG=v1.0.0-beta.5
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_PROVIDER_ALIAS_SECRET=replace-with-a-stable-provider-alias-secret
ARTIFACT_ENCRYPTION_KEY=
AUDIT_TRUSTED_PROXY_HOPS=2
AUDIT_TRUSTED_PROXY_NETWORKS=172.16.0.0/12
DJANGO_HOSTNAME=intelvia.app
DJANGO_DISABLE_LOGINS=True
DJANGO_ENABLE_DEV_IMPERSONATION=False
DJANGO_ENABLE_UNIT_VOLUME_FALLBACK_UPDATES=False
DJANGO_ENABLE_GUIDELINE_THRESHOLD_UPDATES=False
DJANGO_LOGOUT_REDIRECT=https://intelvia.app
DJANGO_CAS_ROOT_PROXIED_AS=https://intelvia.app
PARQUET_ROOT=./parquets
ROLLBACK_RETENTION_COUNT=5
MIN_PARQUET_FREE_BYTES=5368709120

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=False
SENTRY_CAPTURE_HANDLED_HTTP_ERRORS=True

MARIADB_ROOT_PASSWORD=replace-with-root-database-password
MARIADB_APP_USER=intelvia_app
MARIADB_APP_PASSWORD=replace-with-runtime-database-password
MARIADB_MIGRATION_USER=intelvia_migrator
MARIADB_MIGRATION_PASSWORD=replace-with-migration-database-password
MARIADB_REFRESH_USER=intelvia_refresh
MARIADB_REFRESH_PASSWORD=replace-with-refresh-database-password
MARIADB_LEGACY_USER=intelvia
MARIADB_ENCRYPTION_MIGRATION_TIMEOUT=21600
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=intelvia
MARIADB_TLS_CA_HOST_FILE=/etc/intelvia/mariadb/ca.pem
MARIADB_TLS_SERVER_CERT_HOST_FILE=/etc/intelvia/mariadb/server-cert.pem
MARIADB_TLS_SERVER_KEY_HOST_FILE=/etc/intelvia/mariadb/server-key.pem
MARIADB_ENCRYPTION_KEY_HOST_FILE=/etc/intelvia/mariadb/encryption-keys.enc
MARIADB_ENCRYPTION_KEY_PASSWORD_HOST_FILE=/etc/intelvia/mariadb/encryption-key-password

OPENROUTER_API_KEY=
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_SITE_URL=https://intelvia.app
OPENROUTER_APP_NAME=Intelvia
